# HTTP API base URL (e.g. https://abc123.execute-api.us-east-1.amazonaws.com)
VITE_HTTP_API_URL=

# WebSocket API URL (e.g. wss://xyz456.execute-api.us-east-1.amazonaws.com/prod)
VITE_WS_API_URL=

# Cognito Hosted UI domain (e.g. research-agent.auth.us-east-1.amazoncognito.com)
VITE_COGNITO_DOMAIN=

# Cognito App Client ID
VITE_COGNITO_CLIENT_ID=

# OAuth2 redirect URI (defaults to window.location.origin + /research/callback if omitted)
# VITE_COGNITO_REDIRECT_URI=https://esaheki.com/research/callback
